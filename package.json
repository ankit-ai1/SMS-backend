{
  "name": "tenant-db",
  "version": "1.0.0",
  "description": "Tenant -> instance routing + per-tenant connection pooling for School Management System",
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node test/smoke.mjs",
    "start": "node dist/server.js",
    "migrate": "node dist/scripts/migrate.js",
    "provision-tenant": "node dist/scripts/provisionTenant.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0"
  }
}
